# Deployment settings. Local development works without this file.
# Values here override shell/CI settings. Absent keys fall back to the environment.
# Wrangler receives these credentials; they are never uploaded to the Worker.
# Leave credentials unset to use Wrangler login or shell/CI authentication.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
WORKER_NAME=freebin-next
D1_DATABASE_ID=
OAUTH_KV_ID=
# Optional comma-separated custom domains. Empty uses workers.dev.
WORKER_DOMAINS=
SIGNUPS_ENABLED=false
DEPLOYMENT_ENVIRONMENT=production
ADMIN_EMAILS=
DEMO_BIN_ID=demo-public
DEMO_API_KEY=fb_8ffddd4d-6793-46e7-9089-58264fdee4cc
DEMO_RATE_LIMIT_RPS=1
DEMO_BODY_LIMIT_BYTES=20480
DEMO_STORAGE_LIMIT_BYTES=1048576
REPLAY_ALLOWED_ORIGINS=
RUM_SCRIPT_URL=
RUM_APP_NAME=freebin-web
OTEL_EXPORTER_OTLP_ENDPOINT=
# Secrets, supplied atomically with deployment. Generate a unique random salt.
RATE_LIMIT_SALT=
OTEL_SERVER_KEY=
